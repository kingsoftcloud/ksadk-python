# ============================================================
# AgentEngine 环境变量配置
# ============================================================
# 本文件列出所有支持的环境变量。
# 用户只需填写必要的配置，大部分有智能默认值。

# ============================================================
# 模型配置 (必填一个 API Key)
# ============================================================
OPENAI_API_KEY=your-api-key-here

# API 地址 (可选 - 有智能默认值)
# 不配置时自动使用金山云模型服务:
#   - 内网环境: http://kspmas-internal.sdns.ksyun.com/v1 (优先)
#   - 外网环境: https://kspmas.ksyun.com/v1
# OPENAI_API_BASE=https://kspmas.ksyun.com/v1

# 模型名称 (可选)
# OPENAI_MODEL_NAME=deepseek-v3.2

# Serverless 平台也支持:
# LLM_API_KEY, LLM_API_BASE, LLM_MODEL

# ============================================================
# 可观测性 - Langfuse (可选 - 通常由 Serverless 平台注入)
# ============================================================
# 填写 PUBLIC_KEY 即自动启用 Langfuse 追踪
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
# LANGFUSE_HOST=https://xxxxx.langfuse.ksyun.com

# ============================================================
# Agent 元数据 (可选 - 通常由 Serverless 平台注入)
# ============================================================
# AGENT_ID=my-agent-uuid
# AGENT_NAME=MyAgent
# TENANT_ID=tenant-001
# ENVIRONMENT=prod

# Serverless 平台也支持:
# AGENT_RUNTIME_ID, AGENT_RUNTIME_NAME, ACCOUNT_ID

# ============================================================
# 金山云配置 (部署时需要)
# ============================================================
# KS_ACCESS_KEY_ID=xxx
# KS_SECRET_ACCESS_KEY=xxx
# KS_REGION=cn-beijing-6
