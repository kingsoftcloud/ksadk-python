DOCKER_REGISTRY ?= hub.kce.ksyun.com
DOCKER_NAMESPACE ?= bigdata-ai
IMAGE_NAME ?= openclaw-promo
TAG ?= latest

FULL_IMAGE := $(DOCKER_REGISTRY)/$(DOCKER_NAMESPACE)/$(IMAGE_NAME):$(TAG)
CONTEXT := .
DOCKERFILE := Makefile.promo.Dockerfile

.PHONY: build push size

build:
	@echo "🐳 构建 宣传页面专属静态 Web 容器镜像..."
	@echo "============================================================"
	@echo "   基础层镜像: python:3.12-slim"
	@echo "   目标镜像: $(FULL_IMAGE)"
	@echo "   构建上下文: $(CONTEXT)/"
	@echo "   Dockerfile: $(DOCKERFILE)"
	@echo "============================================================"
	@docker build --platform linux/amd64 -f $(DOCKERFILE) -t $(FULL_IMAGE) $(CONTEXT)
	@echo "✅ 构建完成: $(FULL_IMAGE)"

push: build
	@echo "📤 推送 宣传静态 HTML 镜像至 $(DOCKER_NAMESPACE) 仓库: $(FULL_IMAGE)"
	@docker push $(FULL_IMAGE)
	@echo "✅ 推送完成"

size:
	@docker images $(FULL_IMAGE) --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"
