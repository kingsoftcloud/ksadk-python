#!/usr/bin/env bash
set -euo pipefail

CMD_NAME="${OPENCLAW_SAFE_EXEC_COMMAND:-$(basename "$0")}"
WORKSPACE_ROOT="${OPENCLAW_EXEC_SAFE_WORKSPACE_ROOT:-${HOME:-/root}/.openclaw/workspace}"
STATE_DIR="${OPENCLAW_EXEC_SAFE_STATE_DIR:-${HOME:-/root}/.openclaw}"
EXEC_STRICT_MODE_RAW="${OPENCLAW_EXEC_STRICT_MODE:-${OPENCLAW_EXEC_SAFE_MODE:-}}"
EXEC_UNSAFE_MODE_RAW="${OPENCLAW_EXEC_UNSAFE_MODE:-${OPENCLAW_EXEC_RELAXED_MODE:-}}"

is_truthy() {
  local raw
  raw="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
  case "${raw}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

if is_truthy "${EXEC_STRICT_MODE_RAW}"; then
  EXEC_UNSAFE_MODE=0
elif is_truthy "${EXEC_UNSAFE_MODE_RAW}"; then
  EXEC_UNSAFE_MODE=1
else
  # Default mode is relaxed unless OPENCLAW_EXEC_STRICT_MODE=true.
  EXEC_UNSAFE_MODE=1
fi

resolve_python_bin() {
  local candidate
  for candidate in /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  command -v python3 2>/dev/null || return 1
}

resolve_env_bin() {
  local candidate
  for candidate in /usr/bin/env /bin/env; do
    if [[ -x "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  command -v env 2>/dev/null || return 1
}

PYTHON_BIN="$(resolve_python_bin || true)"
ENV_BIN="$(resolve_env_bin || true)"

canon_path() {
  local target="$1"
  if [[ -n "${PYTHON_BIN}" ]]; then
    "${PYTHON_BIN}" - "${target}" <<'PY'
import os
import sys

print(os.path.realpath(os.path.abspath(sys.argv[1])))
PY
    return 0
  fi

  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "${target}" 2>/dev/null || realpath "${target}"
    return 0
  fi

  printf 'Unable to canonicalize path: %s\n' "${target}" >&2
  exit 1
}

deny() {
  printf 'Denied by OpenClaw safe exec policy: %s\n' "$*" >&2
  exit 126
}

WRAPPER_PATH="$(canon_path "$0")"
WRAPPER_DIR="${WRAPPER_PATH%/*}"
SAFE_BIN_CANON="$(canon_path "${OPENCLAW_SAFE_BIN_DIR:-${WRAPPER_DIR}}")"
WORKSPACE_CANON="$(canon_path "${WORKSPACE_ROOT}")"
STATE_CANON="$(canon_path "${STATE_DIR}")"
CWD_CANON="$(pwd -P 2>/dev/null || pwd)"

is_under_root() {
  local candidate root
  candidate="$(canon_path "$1")"
  root="$(canon_path "$2")"
  [[ "${candidate}" == "${root}" || "${candidate}" == "${root}/"* ]]
}

ensure_workspace_cwd() {
  if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
    return 0
  fi
  if ! is_under_root "${CWD_CANON}" "${WORKSPACE_CANON}"; then
    deny "working directory must stay inside workspace (${WORKSPACE_CANON})"
  fi
}

mcporter_target_allowed() {
  local target
  target="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
  case "${target}" in
    kdocs|exa|xiaohongshu|douyin|linkedin|weibo|bosszhipin)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

mcporter_namespace_allowed() {
  local namespace="${1%%.*}"
  mcporter_target_allowed "${namespace}"
}

token_looks_like_path() {
  local token="$1"
  if [[ "${token}" == "." || "${token}" == ".." || "${token}" == "/"* || "${token}" == "./"* || "${token}" == "../"* || "${token}" == "~"* || "${token}" == *"/"* ]]; then
    return 0
  fi
  [[ -e "${token}" ]]
}

validate_workspace_path() {
  if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
    return 0
  fi

  local token="$1"
  local candidate="${token}"

  if [[ "${candidate}" == "~"* ]]; then
    candidate="${HOME}${candidate#"~"}"
  elif [[ "${candidate}" != /* ]]; then
    candidate="${CWD_CANON}/${candidate}"
  fi

  candidate="$(canon_path "${candidate}")"

  case "${candidate}" in
    /proc/*|/dev/*|/sys/*|/etc/*)
      deny "path is outside the safe workspace boundary: ${token}"
      ;;
  esac

  if is_under_root "${candidate}" "${WORKSPACE_CANON}"; then
    return 0
  fi

  if is_under_root "${candidate}" "${STATE_CANON}"; then
    deny "state directory access is blocked: ${token}"
  fi

  if ! is_under_root "${candidate}" "${WORKSPACE_CANON}"; then
    deny "path must remain inside workspace: ${token}"
  fi
}

is_allowlisted_state_shell_script() {
  local candidate
  candidate="$(canon_path "$1")"
  case "${candidate}" in
    "${STATE_CANON}/skills/kdocs/setup.sh"|\
    "${STATE_CANON}/skills/kdocs/get-token.sh")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

resolve_script_token_path() {
  local token="$1"
  local candidate="${token}"

  if [[ "${candidate}" == "~"* ]]; then
    candidate="${HOME}${candidate#"~"}"
  elif [[ "${candidate}" != /* ]]; then
    candidate="${CWD_CANON}/${candidate}"
  fi

  canon_path "${candidate}"
}

validate_shell_script_path() {
  local token="$1"
  local candidate
  candidate="$(resolve_script_token_path "${token}")"

  if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
    printf '%s\n' "${candidate}"
    return 0
  fi

  case "${candidate}" in
    /proc/*|/dev/*|/sys/*|/etc/*)
      deny "path is outside the safe workspace boundary: ${token}"
      ;;
  esac

  if is_under_root "${candidate}" "${WORKSPACE_CANON}"; then
    printf '%s\n' "${candidate}"
    return 0
  fi

  if is_allowlisted_state_shell_script "${candidate}"; then
    printf '%s\n' "${candidate}"
    return 0
  fi

  if is_under_root "${candidate}" "${STATE_CANON}"; then
    deny "state directory script is blocked unless allowlisted: ${token}"
  fi

  deny "path must remain inside workspace: ${token}"
}

resolve_via_path() {
  local bin_name="$1"
  local original_ifs="${IFS}"
  local dir
  local candidate

  IFS=':'
  for dir in ${PATH}; do
    [[ -n "${dir}" ]] || continue
    candidate="${dir}/${bin_name}"
    [[ -x "${candidate}" ]] || continue
    if [[ "$(canon_path "${candidate}")" == "${WRAPPER_PATH}" ]]; then
      continue
    fi
    printf '%s\n' "${candidate}"
    IFS="${original_ifs}"
    return 0
  done
  IFS="${original_ifs}"

  return 1
}

resolve_real_bin() {
  case "${CMD_NAME}" in
    pwd) echo "/usr/bin/pwd" ;;
    ls) echo "/usr/bin/ls" ;;
    whoami) echo "/usr/bin/whoami" ;;
    id) echo "/usr/bin/id" ;;
    uname) echo "/usr/bin/uname" ;;
    date) echo "/usr/bin/date" ;;
    ps) echo "/usr/bin/ps" ;;
    df) echo "/usr/bin/df" ;;
    du) echo "/usr/bin/du" ;;
    stat) echo "/usr/bin/stat" ;;
    find) echo "/usr/bin/find" ;;
    cat) echo "/usr/bin/cat" ;;
    head) echo "/usr/bin/head" ;;
    tail) echo "/usr/bin/tail" ;;
    wc) echo "/usr/bin/wc" ;;
    git) echo "/usr/bin/git" ;;
    sh-safe)
      if [[ -x "/bin/sh" ]]; then
        echo "/bin/sh"
      elif [[ -x "/usr/bin/sh" ]]; then
        echo "/usr/bin/sh"
      else
        resolve_via_path "sh" || deny "wrapped binary not found for sh-safe"
      fi
      ;;
    bash-safe)
      if [[ -x "/bin/bash" ]]; then
        echo "/bin/bash"
      elif [[ -x "/usr/bin/bash" ]]; then
        echo "/usr/bin/bash"
      else
        resolve_via_path "bash" || deny "wrapped binary not found for bash-safe"
      fi
      ;;
    mcporter)
      if [[ -x "/usr/local/bin/mcporter" ]]; then
        echo "/usr/local/bin/mcporter"
      elif [[ -x "/usr/bin/mcporter" ]]; then
        echo "/usr/bin/mcporter"
      else
        resolve_via_path "mcporter" || deny "wrapped binary not found for mcporter"
      fi
      ;;
    web-safe)
      [[ -n "${PYTHON_BIN}" ]] || deny "python3 is required for web-safe"
      echo "${PYTHON_BIN}"
      ;;
    *)
      deny "command is not managed by safe exec wrapper: ${CMD_NAME}"
      ;;
  esac
}

REAL_BIN="$(resolve_real_bin)"
[[ -x "${REAL_BIN}" ]] || deny "wrapped binary not found: ${REAL_BIN}"

case "${CMD_NAME}" in
  pwd|whoami|id|uname|date|ps|df)
    exec "${REAL_BIN}" "$@"
    ;;
  ls|stat|du|cat|head|tail|wc)
    ensure_workspace_cwd
    for arg in "$@"; do
      if [[ "${arg}" == "--" ]]; then
        continue
      fi
      if [[ "${arg}" == -* ]]; then
        continue
      fi
      if token_looks_like_path "${arg}"; then
        validate_workspace_path "${arg}"
      fi
    done
    exec "${REAL_BIN}" "$@"
    ;;
  find)
    ensure_workspace_cwd
    path_mode=1
    for arg in "$@"; do
      case "${arg}" in
        "" )
          continue
          ;;
        --)
          path_mode=0
          ;;
        -*) path_mode=0 ;;
        '!'|'(' | ')') path_mode=0 ;;
      esac
      if [[ "${path_mode}" == "1" ]]; then
        validate_workspace_path "${arg}"
      fi
    done
    exec "${REAL_BIN}" "$@"
    ;;
  git)
    ensure_workspace_cwd
    subcommand=""
    previous_wants_value=0
    for arg in "$@"; do
      if [[ "${previous_wants_value}" == "1" ]]; then
        previous_wants_value=0
        continue
      fi
      case "${arg}" in
        -C|--git-dir|--work-tree|--exec-path|--config-env|-c)
          deny "git option is blocked by safe exec policy: ${arg}"
          ;;
        --no-pager|--paginate)
          previous_wants_value=0
          ;;
        --help|-h)
          previous_wants_value=0
          ;;
        --*)
          ;;
        -*)
          ;;
        *)
          if [[ -z "${subcommand}" ]]; then
            subcommand="${arg}"
            case "${subcommand}" in
              status|diff|log|show|branch|rev-parse|ls-files|blame)
                ;;
              *)
                deny "git subcommand is not allowlisted: ${subcommand}"
                ;;
            esac
            continue
          fi
          if token_looks_like_path "${arg}"; then
            validate_workspace_path "${arg}"
          fi
          ;;
      esac
    done
    [[ -n "${subcommand}" ]] || deny "git requires an allowlisted read-only subcommand"
    exec "${REAL_BIN}" "$@"
    ;;
  sh-safe)
    ensure_workspace_cwd
    if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
      exec "${REAL_BIN}" "$@"
    fi
    [[ "$#" -ge 1 ]] || deny "sh-safe requires a workspace script path"
    [[ "$1" != -* ]] || deny "sh-safe does not accept shell options"

    script_path="$(validate_shell_script_path "$1")"
    trusted_state_script=0
    if is_allowlisted_state_shell_script "${script_path}"; then
      trusted_state_script=1
    fi

    [[ -f "${script_path}" ]] || deny "sh-safe script must be a readable file inside workspace"
    [[ -r "${script_path}" ]] || deny "sh-safe script must be a readable file inside workspace"
    [[ -n "${ENV_BIN}" ]] || deny "env utility is required for sh-safe"

    safe_tmp_dir="${WORKSPACE_CANON}/.tmp/openclaw"
    safe_home="${WORKSPACE_CANON}"
    safe_path="${SAFE_BIN_CANON}"
    if [[ "${trusted_state_script}" == "1" ]]; then
      safe_home="${STATE_CANON}"
      safe_path="${SAFE_BIN_CANON}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    fi
    mkdir -p "${safe_tmp_dir}"
    shift
    umask 077

    # Clear inherited secrets and only expose the wrapper directory back to the script.
    exec "${ENV_BIN}" -i \
      HOME="${safe_home}" \
      LOGNAME="openclaw" \
      USER="openclaw" \
      PWD="${CWD_CANON}" \
      PATH="${safe_path}" \
      SHELL="${REAL_BIN}" \
      TMPDIR="${safe_tmp_dir}" \
      LANG="C.UTF-8" \
      LC_ALL="C.UTF-8" \
      OPENCLAW_EXEC_SAFE_WORKSPACE_ROOT="${WORKSPACE_CANON}" \
      OPENCLAW_EXEC_SAFE_STATE_DIR="${STATE_CANON}" \
      OPENCLAW_SAFE_BIN_DIR="${SAFE_BIN_CANON}" \
      "${REAL_BIN}" -- "${script_path}" "$@" < /dev/null
    ;;
  bash-safe)
    ensure_workspace_cwd
    if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
      exec "${REAL_BIN}" "$@"
    fi
    [[ "$#" -ge 1 ]] || deny "bash-safe requires a workspace script path"
    [[ "$1" != -* ]] || deny "bash-safe does not accept shell options"

    script_path="$(validate_shell_script_path "$1")"
    trusted_state_script=0
    if is_allowlisted_state_shell_script "${script_path}"; then
      trusted_state_script=1
    fi

    [[ -f "${script_path}" ]] || deny "bash-safe script must be a readable file inside workspace"
    [[ -r "${script_path}" ]] || deny "bash-safe script must be a readable file inside workspace"
    [[ -n "${ENV_BIN}" ]] || deny "env utility is required for bash-safe"

    safe_tmp_dir="${WORKSPACE_CANON}/.tmp/openclaw"
    safe_home="${WORKSPACE_CANON}"
    safe_path="${SAFE_BIN_CANON}"
    if [[ "${trusted_state_script}" == "1" ]]; then
      safe_home="${STATE_CANON}"
      safe_path="${SAFE_BIN_CANON}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    fi
    mkdir -p "${safe_tmp_dir}"
    shift
    umask 077

    exec "${ENV_BIN}" -i \
      HOME="${safe_home}" \
      LOGNAME="openclaw" \
      USER="openclaw" \
      PWD="${CWD_CANON}" \
      PATH="${safe_path}" \
      SHELL="${REAL_BIN}" \
      TMPDIR="${safe_tmp_dir}" \
      LANG="C.UTF-8" \
      LC_ALL="C.UTF-8" \
      OPENCLAW_EXEC_SAFE_WORKSPACE_ROOT="${WORKSPACE_CANON}" \
      OPENCLAW_EXEC_SAFE_STATE_DIR="${STATE_CANON}" \
      OPENCLAW_SAFE_BIN_DIR="${SAFE_BIN_CANON}" \
      "${REAL_BIN}" --noprofile --norc "${script_path}" "$@" < /dev/null
    ;;
  mcporter)
    ensure_workspace_cwd
    if [[ "${EXEC_UNSAFE_MODE}" == "1" ]]; then
      exec "${REAL_BIN}" "$@"
    fi
    subcommand=""
    config_action=""
    target=""
    command_value=""
    previous_wants_value=""
    for arg in "$@"; do
      if [[ -n "${previous_wants_value}" ]]; then
        if [[ "${previous_wants_value}" == "--command" ]]; then
          command_value="${arg}"
        fi
        previous_wants_value=""
        continue
      fi
      case "${arg}" in
        --config|--root|--cwd|--env|--stdio|--http-url|--persist|--allow-http|--name|--server|--from)
          deny "mcporter option is blocked by safe exec policy: ${arg}"
          ;;
        --command|--tool|--args|--output|--log-level|--oauth-timeout)
          previous_wants_value="${arg}"
          continue
          ;;
        --help|-h|--version|--json|--raw|--schema|--all-parameters|--verbose)
          continue
          ;;
        --*)
          continue
          ;;
        -*)
          continue
          ;;
        *)
          if [[ -z "${subcommand}" ]]; then
            subcommand="${arg}"
            continue
          fi
          if [[ "${subcommand}" == "config" && -z "${config_action}" ]]; then
            config_action="${arg}"
            continue
          fi
          if [[ -z "${target}" ]]; then
            target="${arg}"
          fi
          ;;
      esac
    done

    case "${subcommand}" in
      ""|help)
        exec "${REAL_BIN}" "$@"
        ;;
      list)
        if [[ -n "${target}" ]] && ! mcporter_namespace_allowed "${target}"; then
          deny "mcporter list is restricted to built-in namespaces"
        fi
        exec "${REAL_BIN}" "$@"
        ;;
      call)
        if [[ -n "${target}" ]] && mcporter_namespace_allowed "${target}"; then
          exec "${REAL_BIN}" "$@"
        fi
        deny "mcporter call is restricted to built-in namespaces"
        ;;
      config)
        case "${config_action}" in
          ""|help|list)
            exec "${REAL_BIN}" "$@"
            ;;
          get|remove)
            mcporter_target_allowed "${target}" || deny "mcporter config ${config_action} is restricted to built-in namespaces"
            exec "${REAL_BIN}" "$@"
            ;;
          add)
            mcporter_target_allowed "${target}" || deny "mcporter config add is restricted to built-in namespaces"
            if [[ "${target}" == "weibo" && -n "${command_value}" && "${command_value}" != "mcp-server-weibo" ]]; then
              deny "mcporter config add weibo only allows mcp-server-weibo"
            fi
            exec "${REAL_BIN}" "$@"
            ;;
          *)
            deny "mcporter config subcommand is not allowlisted: ${config_action}"
            ;;
        esac
        ;;
      *.*)
        if mcporter_namespace_allowed "${subcommand}"; then
          exec "${REAL_BIN}" "$@"
        fi
        deny "mcporter namespace is not allowlisted: ${subcommand}"
        ;;
      *)
        deny "mcporter subcommand is not allowlisted: ${subcommand}"
        ;;
    esac
    ;;
  web-safe)
    ensure_workspace_cwd
    [[ -n "${ENV_BIN}" ]] || deny "env utility is required for web-safe"
    safe_tmp_dir="${WORKSPACE_CANON}/.tmp/openclaw"
    mkdir -p "${safe_tmp_dir}"
    umask 077
    web_safe_search_api_key="${OPENCLAW_WEB_SAFE_SEARCH_API_KEY:-}"
    web_safe_search_secret_source="$(printf '%s' "${OPENCLAW_WEB_SAFE_SEARCH_SECRET_SOURCE:-${OPENCLAW_MODEL_API_KEY_SECRET_SOURCE:-}}" | tr '[:upper:]' '[:lower:]')"
    if [[ -z "${web_safe_search_api_key}" && "${web_safe_search_secret_source}" != "file" ]]; then
      web_safe_search_secret_env_name="${OPENCLAW_MODEL_API_KEY_SECRET_ID:-}"
      if [[ -n "${web_safe_search_secret_env_name}" && "${web_safe_search_secret_env_name}" != */* ]]; then
        web_safe_search_api_key="${!web_safe_search_secret_env_name:-}"
      fi
    fi
    if [[ -z "${web_safe_search_api_key}" && "${web_safe_search_secret_source}" != "file" ]]; then
      for candidate_key in \
        "${OPENCLAW_MODEL_API_KEY:-}" \
        "${OPENAI_API_KEY:-}" \
        "${LLM_API_KEY:-}" \
        "${MODEL_API_KEY:-}"
      do
        if [[ -n "${candidate_key}" ]]; then
          web_safe_search_api_key="${candidate_key}"
          break
        fi
      done
    fi

    exec "${ENV_BIN}" -i \
      HOME="${WORKSPACE_CANON}" \
      LOGNAME="openclaw" \
      USER="openclaw" \
      PWD="${CWD_CANON}" \
      PATH="${SAFE_BIN_CANON}" \
      TMPDIR="${safe_tmp_dir}" \
      LANG="C.UTF-8" \
      LC_ALL="C.UTF-8" \
      OPENCLAW_EXEC_SAFE_WORKSPACE_ROOT="${WORKSPACE_CANON}" \
      OPENCLAW_EXEC_SAFE_STATE_DIR="${STATE_CANON}" \
      OPENCLAW_SAFE_BIN_DIR="${SAFE_BIN_CANON}" \
      OPENCLAW_WEB_SAFE_UNRESTRICTED="${EXEC_UNSAFE_MODE}" \
      OPENCLAW_MODEL_PROVIDER_ID="${OPENCLAW_MODEL_PROVIDER_ID:-}" \
      OPENCLAW_MODEL_BASE_URL="${OPENCLAW_MODEL_BASE_URL:-}" \
      OPENCLAW_DEFAULT_MODEL="${OPENCLAW_DEFAULT_MODEL:-}" \
      OPENAI_MODEL_NAME="${OPENAI_MODEL_NAME:-}" \
      MODEL_NAME="${MODEL_NAME:-}" \
      LLM_MODEL="${LLM_MODEL:-}" \
      OPENCLAW_MODEL_API="${OPENCLAW_MODEL_API:-}" \
      OPENCLAW_MODEL_API_KEY_SECRET_SOURCE="${OPENCLAW_MODEL_API_KEY_SECRET_SOURCE:-}" \
      OPENCLAW_MODEL_API_KEY_SECRET_FILE_PATH="${OPENCLAW_MODEL_API_KEY_SECRET_FILE_PATH:-}" \
      OPENCLAW_MODEL_API_KEY_SECRET_ID="${OPENCLAW_MODEL_API_KEY_SECRET_ID:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_MODE="${OPENCLAW_WEB_SAFE_SEARCH_MODE:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_MODEL="${OPENCLAW_WEB_SAFE_SEARCH_MODEL:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_BASE_URL="${OPENCLAW_WEB_SAFE_SEARCH_BASE_URL:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_API="${OPENCLAW_WEB_SAFE_SEARCH_API:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_SECRET_SOURCE="${OPENCLAW_WEB_SAFE_SEARCH_SECRET_SOURCE:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_SECRET_FILE_PATH="${OPENCLAW_WEB_SAFE_SEARCH_SECRET_FILE_PATH:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_SECRET_ID="${OPENCLAW_WEB_SAFE_SEARCH_SECRET_ID:-}" \
      OPENCLAW_WEB_SAFE_SEARCH_API_KEY="${web_safe_search_api_key}" \
      OPENCLAW_WEB_SAFE_SEARCH_ENDPOINT="${OPENCLAW_WEB_SAFE_SEARCH_ENDPOINT:-}" \
      OPENCLAW_WEB_SAFE_READER_ENDPOINT="${OPENCLAW_WEB_SAFE_READER_ENDPOINT:-}" \
      "${REAL_BIN}" - "$@" <<'PY'
import html
import ipaddress
import json
import os
import socket
import sys
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET


USER_AGENT = "OpenClaw-WebSafe/1.0"
DEFAULT_KSYUN_BASE_URL = "http://kspmas-internal.sdns.ksyun.com/v1"
DEFAULT_KSYUN_MODEL_SEARCH_MODEL = "deepseek-v3.2"
MODEL_SEARCH_TIMEOUT_SECONDS = 30
READER_ENDPOINT = os.getenv("OPENCLAW_WEB_SAFE_READER_ENDPOINT", "https://r.jina.ai/")
SEARCH_ENDPOINT = os.getenv("OPENCLAW_WEB_SAFE_SEARCH_ENDPOINT", "https://cn.bing.com/search?format=rss&q={query}")
BLOCKED_HOST_SUFFIXES = (
    ".internal",
    ".local",
    ".localdomain",
    ".cluster.local",
)
BLOCKED_HOSTS = {
    "localhost",
    "metadata",
    "metadata.google.internal",
    "kubernetes.default",
    "kubernetes.default.svc",
    "100.100.100.200",
    "169.254.169.254",
}
WEB_SAFE_UNRESTRICTED = str(os.getenv("OPENCLAW_WEB_SAFE_UNRESTRICTED", "")).strip().lower() in {"1", "true", "yes", "on"}


def usage(message):
    print(f"Usage error: {message}", file=sys.stderr)
    sys.exit(2)


def deny(message):
    print(f"Denied by OpenClaw web-safe policy: {message}", file=sys.stderr)
    sys.exit(126)


def clean_text(value):
    text = html.unescape(value or "")
    return " ".join(text.replace("\xa0", " ").split())


def env_value(*names, default=""):
    for name in names:
      text = str(os.getenv(name, "")).strip()
      if text:
        return text
    return default


def trim_model_name(model_name):
    raw_model_name = str(model_name or "").strip()
    if not raw_model_name:
      return ""
    return raw_model_name.split("/", 1)[1] if "/" in raw_model_name else raw_model_name


def json_pointer_get(payload, pointer):
    current = payload
    for token in str(pointer or "").split("/")[1:]:
      key = token.replace("~1", "/").replace("~0", "~")
      if isinstance(current, list):
        try:
          current = current[int(key)]
        except (ValueError, IndexError):
          return ""
      elif isinstance(current, dict):
        if key not in current:
          return ""
        current = current[key]
      else:
        return ""
    return current


def load_secret_from_file(file_path, secret_id):
    if not file_path or not os.path.exists(file_path):
      return ""
    try:
      with open(file_path, "r", encoding="utf-8") as handle:
        payload = json.load(handle)
    except (OSError, json.JSONDecodeError):
      return ""
    value = json_pointer_get(payload, secret_id)
    return str(value).strip() if value is not None else ""


def resolve_model_search_settings():
    mode = env_value("OPENCLAW_WEB_SAFE_SEARCH_MODE", default="bing").lower()
    if mode not in {"auto", "model", "bing"}:
      mode = "auto"

    provider_id = env_value("OPENCLAW_MODEL_PROVIDER_ID", default="ksyun").lower()
    base_url = env_value(
      "OPENCLAW_WEB_SAFE_SEARCH_BASE_URL",
      "OPENCLAW_MODEL_BASE_URL",
      "OPENAI_BASE_URL",
      "OPENAI_API_BASE",
      default=DEFAULT_KSYUN_BASE_URL if provider_id == "ksyun" else "",
    )
    api_name = env_value("OPENCLAW_WEB_SAFE_SEARCH_API", "OPENCLAW_MODEL_API", default="openai-completions").lower()
    explicit_search_model = env_value("OPENCLAW_WEB_SAFE_SEARCH_MODEL")
    default_model = env_value("OPENCLAW_DEFAULT_MODEL", "OPENAI_MODEL_NAME", "MODEL_NAME", "LLM_MODEL")
    model_name = trim_model_name(explicit_search_model)
    if not model_name:
      if provider_id == "ksyun":
        model_name = DEFAULT_KSYUN_MODEL_SEARCH_MODEL
      else:
        model_name = trim_model_name(default_model)

    state_dir = env_value("OPENCLAW_EXEC_SAFE_STATE_DIR")
    secret_source = env_value(
      "OPENCLAW_WEB_SAFE_SEARCH_SECRET_SOURCE",
      "OPENCLAW_MODEL_API_KEY_SECRET_SOURCE",
      default="file",
    ).lower()
    secret_file_path = env_value(
      "OPENCLAW_WEB_SAFE_SEARCH_SECRET_FILE_PATH",
      "OPENCLAW_MODEL_API_KEY_SECRET_FILE_PATH",
      default=os.path.join(state_dir, "secrets.json") if state_dir else "",
    )
    secret_id = env_value(
      "OPENCLAW_WEB_SAFE_SEARCH_SECRET_ID",
      "OPENCLAW_MODEL_API_KEY_SECRET_ID",
      default=f"/providers/{provider_id or 'default'}/apiKey",
    )
    api_key = env_value("OPENCLAW_WEB_SAFE_SEARCH_API_KEY")

    explicit_search_configured = bool(
      explicit_search_model
      or env_value("OPENCLAW_WEB_SAFE_SEARCH_BASE_URL")
      or env_value("OPENCLAW_WEB_SAFE_SEARCH_API_KEY")
    )
    if mode == "bing":
      return None
    if mode == "auto":
      provider_looks_supported = provider_id == "ksyun" or "kspmas" in base_url.lower()
      if not explicit_search_configured and not provider_looks_supported:
        return None

    return {
      "mode": mode,
      "provider_id": provider_id,
      "base_url": base_url,
      "api_name": api_name,
      "model_name": model_name,
      "secret_source": secret_source,
      "secret_file_path": secret_file_path,
      "secret_id": secret_id,
      "api_key": api_key,
    }


def model_search_api_key(settings):
    api_key = str((settings or {}).get("api_key") or "").strip()
    if api_key:
      return api_key
    if str((settings or {}).get("secret_source") or "").lower() == "file":
      return load_secret_from_file(
        str((settings or {}).get("secret_file_path") or "").strip(),
        str((settings or {}).get("secret_id") or "").strip(),
      )
    return ""


def strip_code_fence(raw_text):
    text = str(raw_text or "").strip()
    if not text.startswith("```"):
      return text
    lines = text.splitlines()
    if lines and lines[0].startswith("```"):
      lines = lines[1:]
    if lines and lines[-1].strip() == "```":
      lines = lines[:-1]
    return "\n".join(lines).strip()


def extract_message_content(response_payload):
    choices = response_payload.get("choices") or []
    if not choices:
      raise ValueError("model search response missing choices")
    message = choices[0].get("message") or {}
    content = message.get("content")
    if isinstance(content, list):
      parts = []
      for item in content:
        if isinstance(item, dict):
          text = item.get("text") or item.get("content") or ""
        else:
          text = str(item)
        if text:
          parts.append(str(text))
      return "\n".join(parts).strip()
    return str(content or "").strip()


def normalize_model_search_results(results, limit):
    normalized = []
    for item in list(results or [])[:limit]:
      if not isinstance(item, dict):
        continue
      title = clean_text(str(item.get("title") or item.get("name") or ""))
      link = clean_text(str(item.get("url") or item.get("link") or ""))
      description = clean_text(
        str(
          item.get("snippet")
          or item.get("summary")
          or item.get("description")
          or ""
        )
      )
      source = clean_text(str(item.get("source") or item.get("site") or item.get("domain") or ""))
      pub_date = clean_text(
        str(
          item.get("published_at")
          or item.get("publishedAt")
          or item.get("published")
          or item.get("date")
          or ""
        )
      )
      if not (title or link or description):
        continue
      normalized.append(
        {
          "title": title,
          "link": link,
          "description": description,
          "pub_date": pub_date,
          "source": source,
        }
      )
    return normalized


def post_json(url, payload, api_key):
    request = urllib.request.Request(
      url,
      data=json.dumps(payload).encode("utf-8"),
      headers={
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
      },
      method="POST",
    )
    try:
      with urllib.request.urlopen(request, timeout=MODEL_SEARCH_TIMEOUT_SECONDS) as response:
        charset = response.headers.get_content_charset() or "utf-8"
        return json.loads(response.read().decode(charset, errors="replace"))
    except urllib.error.HTTPError as exc:
      body = exc.read().decode("utf-8", errors="replace")
      raise RuntimeError(body[:4000] or f"model search http error: {exc.code}") from exc
    except urllib.error.URLError as exc:
      raise RuntimeError(f"model search network error: {exc}") from exc


def run_model_search(query, limit):
    settings = resolve_model_search_settings()
    if not settings:
      return None
    if settings["api_name"] and settings["api_name"] != "openai-completions":
      return None
    if not settings["base_url"] or not settings["model_name"]:
      return None

    api_key = model_search_api_key(settings)
    if not api_key:
      return None

    base_url = settings["base_url"].rstrip("/")
    chat_url = base_url if base_url.endswith("/chat/completions") else f"{base_url}/chat/completions"
    response_payload = post_json(
      chat_url,
      {
        "model": settings["model_name"],
        "messages": [
          {
            "role": "system",
            "content": (
              "You are a web search formatter. "
              "Use the web_search tool and return only a valid JSON object."
            ),
          },
          {
            "role": "user",
            "content": (
              f"Search the public web for the query: {query}\n"
              f"Return a JSON object with keys query and results.\n"
              f"results must contain at most {limit} items.\n"
              "Each result item must include title, url, snippet, source, published_at.\n"
              "Do not fabricate URLs. Use empty strings for missing fields."
            ),
          },
        ],
        "response_format": {
          "type": "json_object",
        },
        "tools": [
          {
            "type": "web_search",
          }
        ],
      },
      api_key,
    )
    response_text = strip_code_fence(extract_message_content(response_payload))
    parsed = json.loads(response_text)
    results = normalize_model_search_results(
      parsed.get("results") or parsed.get("items") or parsed.get("links") or [],
      limit,
    )
    source_label = "KSPMAS web_search" if settings["provider_id"] == "ksyun" or "kspmas" in base_url.lower() else "Model web_search"
    return {
      "source": f"{source_label} (model: {settings['model_name']})",
      "results": results,
    }


def resolve_ip(host):
    resolved = []
    try:
      infos = socket.getaddrinfo(host, None, proto=socket.IPPROTO_TCP)
    except socket.gaierror as exc:
      deny(f"cannot resolve host: {host} ({exc})")
    for info in infos:
      raw_ip = info[4][0]
      try:
        resolved.append(ipaddress.ip_address(raw_ip))
      except ValueError:
        continue
    return resolved


def ensure_public_host(host):
    if WEB_SAFE_UNRESTRICTED:
      return
    host = (host or "").strip().lower().rstrip(".")
    if not host:
      deny("URL host is required")
    if host in BLOCKED_HOSTS:
      deny(f"host is blocked: {host}")
    if any(host.endswith(suffix) for suffix in BLOCKED_HOST_SUFFIXES):
      deny(f"host is blocked: {host}")
    try:
      host_ip = ipaddress.ip_address(host)
      ips = [host_ip]
    except ValueError:
      ips = resolve_ip(host)
    if not ips:
      deny(f"host does not resolve to a public address: {host}")
    for candidate in ips:
      if (
        candidate.is_private
        or candidate.is_loopback
        or candidate.is_link_local
        or candidate.is_multicast
        or candidate.is_reserved
        or candidate.is_unspecified
      ):
        deny(f"host resolves to a non-public address: {host}")


def http_get(url, accept=None):
    headers = {"User-Agent": USER_AGENT}
    if accept:
      headers["Accept"] = accept
    request = urllib.request.Request(url, headers=headers, method="GET")
    try:
      with urllib.request.urlopen(request, timeout=20) as response:
        charset = response.headers.get_content_charset() or "utf-8"
        return response.read().decode(charset, errors="replace")
    except urllib.error.HTTPError as exc:
      body = exc.read().decode("utf-8", errors="replace")
      print(body[:4000], file=sys.stderr)
      sys.exit(exc.code if exc.code < 256 else 1)
    except urllib.error.URLError as exc:
      print(f"Network error: {exc}", file=sys.stderr)
      sys.exit(1)


def print_search_results(query, source_label, items):
    print(f"Search query: {query}")
    print(f"Source: {source_label}")
    if not items:
      print("No results found.")
      return

    for index, item in enumerate(items, start=1):
      title = clean_text(item.get("title", ""))
      link = clean_text(item.get("link", ""))
      description = clean_text(item.get("description", ""))
      pub_date = clean_text(item.get("pub_date", ""))
      source = clean_text(item.get("source", ""))
      print()
      print(f"{index}. {title or '(untitled)'}")
      if link:
        print(f"URL: {link}")
      if source:
        print(f"Site: {source}")
      if pub_date:
        print(f"Published: {pub_date}")
      if description:
        print(f"Summary: {description}")


def run_search(args):
    limit = 5
    query_parts = []
    idx = 0
    while idx < len(args):
      token = args[idx]
      if token == "--limit":
        idx += 1
        if idx >= len(args):
          usage("--limit requires a value")
        try:
          limit = int(args[idx])
        except ValueError:
          usage("--limit must be an integer")
        if limit < 1 or limit > 10:
          usage("--limit must be between 1 and 10")
      elif token.startswith("--limit="):
        try:
          limit = int(token.split("=", 1)[1])
        except ValueError:
          usage("--limit must be an integer")
        if limit < 1 or limit > 10:
          usage("--limit must be between 1 and 10")
      elif token.startswith("-"):
        usage(f"unsupported option: {token}")
      else:
        query_parts.append(token)
      idx += 1
    query = " ".join(query_parts).strip()
    if not query:
      usage("search requires a query")

    try:
      model_search_result = run_model_search(query, limit)
    except Exception:
      model_search_result = None
    if model_search_result is not None:
      print_search_results(query, model_search_result["source"], model_search_result["results"])
      return

    search_url = SEARCH_ENDPOINT.format(query=urllib.parse.quote(query))
    raw_xml = http_get(search_url, accept="application/rss+xml, application/xml;q=0.9, text/xml;q=0.8")
    try:
      root = ET.fromstring(raw_xml)
    except ET.ParseError as exc:
      print(f"Search parse error: {exc}", file=sys.stderr)
      sys.exit(1)

    items = root.findall("./channel/item")
    print_search_results(
      query,
      "Bing RSS (public web, no API key)",
      [
        {
          "title": item.findtext("title", default=""),
          "link": item.findtext("link", default=""),
          "description": item.findtext("description", default=""),
          "pub_date": item.findtext("pubDate", default=""),
          "source": "",
        }
        for item in items[:limit]
      ],
    )


def run_read(args):
    if len(args) != 1:
      usage("read requires exactly one URL")
    target_url = args[0].strip()
    parsed = urllib.parse.urlparse(target_url)
    if parsed.scheme not in {"http", "https"}:
      deny("only http/https URLs are allowed")
    ensure_public_host(parsed.hostname or "")
    reader_url = urllib.parse.urljoin(READER_ENDPOINT, target_url)
    content = http_get(reader_url, accept="text/markdown, text/plain;q=0.9, */*;q=0.1")
    print(content.rstrip())


def main(argv):
    if not argv:
      usage("expected subcommand: search | read")
    subcommand = argv[0]
    remaining = argv[1:]
    if subcommand == "search":
      run_search(remaining)
      return 0
    if subcommand == "read":
      run_read(remaining)
      return 0
    usage(f"unsupported subcommand: {subcommand}")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
