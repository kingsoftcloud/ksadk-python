# ╔══════════════════════════════════════════════════════════╗
# ║         KsADK 知识库问答示例 — 环境变量配置              ║
# ║                                                        ║
# ║  使用方法: cp .env.example .env  然后按注释填入真实值     ║
# ╚══════════════════════════════════════════════════════════╝


# ==============================================================
# 1. 模型配置 (LLM)
# ==============================================================
#
# OPENAI_API_KEY:
#   获取方式: 联系团队管理员获取内部模型服务的 API Key
#
# OPENAI_API_BASE:
#   内部模型服务地址，通常不需要修改
#
OPENAI_API_KEY=<在此填入你的 API Key>
OPENAI_API_BASE=http://kspmas.ksyun.com/v1
MODEL_NAME=deepseek-v3.2


# ==============================================================
# 2. 知识库配置 (必填 — 3 个值)
# ==============================================================
#
# ┌─────────────────────────────────────────────────────────┐
# │ 获取步骤:                                                │
# │                                                         │
# │ (1) KSADK_KB_DATASET_ID — 知识库 ID                      │
# │     登录 金山云 AICP 控制台:                               │
# │       https://ai.ksyun.com → 知识库管理                  │
# │     创建知识库 → 上传文档 → 复制知识库 ID                   │
# │     (格式类似: 1795516d-1c58-48fc-8e96-08d6bdaa912e)      │
# │                                                         │
# │ (2) KSYUN_ACCESS_KEY / KSYUN_SECRET_KEY — AK/SK         │
# │     登录 金山云控制台:                                     │
# │       https://iam.console.ksyun.com/                    │
# │     → 右上角头像 → AccessKey 管理 → 创建 AccessKey        │
# │     创建后会显示 AK 和 SK，请妥善保存（SK 仅显示一次）      │
# └─────────────────────────────────────────────────────────┘
#
KSADK_KB_DATASET_ID=<在此填入知识库 ID>
KSYUN_ACCESS_KEY=<在此填入 AccessKey>
KSYUN_SECRET_KEY=<在此填入 SecretKey>


# ==============================================================
# 3. 网络配置 (根据你的网络环境二选一)
# ==============================================================
#
# 如果你在 金山云内网服务器 上运行（如 ECS、容器服务等）:
#   使用内网端点，延迟更低
KSADK_KB_ENDPOINT=aicp.inner.api.ksyun.com
KSADK_KB_SCHEME=http
#
# 如果你在 本地电脑 / 非金山云环境 运行:
#   取消下面两行的注释，注释掉上面两行
# KSADK_KB_ENDPOINT=aicp.api.ksyun.com
# KSADK_KB_SCHEME=https


# ==============================================================
# 4. 高级配置 (可选 — 一般不需要修改)
# ==============================================================
#
# KSADK_KB_REGION=cn-north-vip1              # API 区域
# KSADK_KB_TOP_K=5                           # 返回结果数 (默认 5)
# KSADK_KB_SEARCH_METHOD=intelligence_search # 检索方法
# KSADK_KB_SCORE_THRESHOLD=0.5              # 分数阈值 (设置后过滤低分结果)
# KSADK_KB_RERANKING_ENABLE=false           # 重排序 (true 可提高精度)
#
# 知识库专用 AK/SK (如果你想让知识库用不同的凭证，可在这里单独配置):
# KSADK_KB_ACCESS_KEY=<知识库专用 AK>
# KSADK_KB_SECRET_KEY=<知识库专用 SK>


# ==============================================================
# 5. 可观测性 (可选)
# ==============================================================
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
