# ============== 模型配置 ==============
MODEL_NAME=deepseek-v3.2
OPENAI_API_BASE=https://your-api-endpoint.com/v1
OPENAI_API_KEY=sk-xxx

# ============== 短期记忆 (会话管理) ==============
# 默认 InMemory，不设置也可以
# KSADK_STM_BACKEND=local

# 如果需要持久化 session:
# KSADK_STM_BACKEND=sqlite
# KSADK_STM_DB_PATH=/tmp/ksadk_sessions.db

# ============== 长期记忆 (跨 session) ==============
# 本地开发测试 (InMemory，关键词匹配)
KSADK_LTM_BACKEND=local

# 生产环境 (金山云记忆服务)
# KSADK_LTM_BACKEND=http
# KSADK_LTM_HTTP_URL=https://memory.ksyun.com/api/v1
# KSADK_LTM_HTTP_TOKEN=sk-xxx
# KSADK_LTM_TOP_K=5
