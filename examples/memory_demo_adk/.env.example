# ╔══════════════════════════════════════════════════════════╗
# ║         KsADK 记忆库测试 — 环境变量配置                  ║
# ║                                                        ║
# ║  使用方法: cp .env.example .env  然后按注释填入真实值     ║
# ╚══════════════════════════════════════════════════════════╝


# ==============================================================
# 1. 模型配置 (LLM) — Test 3-5 需要
# ==============================================================
OPENAI_API_KEY=<在此填入你的 API Key>
OPENAI_API_BASE=http://kspmas.ksyun.com/v1
MODEL_NAME=deepseek-v3.2


# ==============================================================
# 2. 记忆库配置 (Test 1-4 使用 local 后端，无需额外配置)
# ==============================================================
#
# 本地开发:
KSADK_LTM_BACKEND=local
#
# 远程服务 (生产环境):
# KSADK_LTM_BACKEND=http
# KSADK_LTM_HTTP_URL=https://memory.ksyun.com/api/v1
# KSADK_LTM_HTTP_TOKEN=sk-xxx
#
# SDK 记忆库后端 (通过金山云 AICP API，生产推荐):
# KSADK_LTM_BACKEND=sdk
# KSADK_LTM_ACCESS_KEY=<AccessKey>       # 或复用 KSYUN_ACCESS_KEY
# KSADK_LTM_SECRET_KEY=<SecretKey>       # 或复用 KSYUN_SECRET_KEY
# KSADK_LTM_REGION=cn-north-vip1
# KSADK_LTM_NAMESPACE=<命名空间>          # 记忆库命名空间，用于隔离不同应用
# KSADK_LTM_AGENT_ID=<Agent ID>          # 可选
# KSADK_LTM_SCENE_ID=<场景 ID>           # 可选
#
# 网络配置 (二选一):
# 内网 (推荐，延迟低):
# KSADK_LTM_ENDPOINT=aicp.inner.api.ksyun.com
# KSADK_LTM_SCHEME=http
# 外网:
# KSADK_LTM_ENDPOINT=aicp.api.ksyun.com
# KSADK_LTM_SCHEME=https
#
# KSADK_LTM_TOP_K=5         # 检索返回数量 (默认 5)
# KSADK_LTM_INDEX=my_app    # 索引名称 (默认使用 agent name)


# ==============================================================
# 3. 短期记忆配置 (可选)
# ==============================================================
#
# KSADK_STM_BACKEND=local          # local / sqlite / database
# KSADK_STM_DB_PATH=/tmp/ksadk.db  # SQLite 路径 (backend=sqlite 时)
# KSADK_STM_DB_URL=                # 数据库 URL (backend=database 时)


# ==============================================================
# 4. 知识库配置 (Test 5 联合测试需要)
# ==============================================================
#
# KSADK_KB_DATASET_ID=<知识库 ID>
# KSYUN_ACCESS_KEY=<AccessKey>
# KSYUN_SECRET_KEY=<SecretKey>
#
# 网络配置 (内网/外网):
# KSADK_KB_ENDPOINT=aicp.inner.api.ksyun.com
# KSADK_KB_SCHEME=http
# 或外网:
# KSADK_KB_ENDPOINT=aicp.api.ksyun.com
# KSADK_KB_SCHEME=https


# ==============================================================
# 5. 可观测性 (可选)
# ==============================================================
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
