# 智能助手 Agent (ADK 版本)
# 复制此文件为 .env 并填入您的配置
# ======================
# 模型配置 (必填, 可以从星流平台获取https://ksp.console.ksyun.com/#/apiKey)
# ======================
OPENAI_API_KEY=your_key
# 可选：自定义 API 地址和模型
# OPENAI_API_BASE=your_api_base #default: http://kspmas.ksyun.com/v1
# OPENAI_MODEL_NAME=your_model_name #default: deepseek-v3.2

# ======================
# 可观测性 (可选)
# ======================
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx

# ======================
# 金山云配置 (可选)
# ======================
KSYUN_ACCESS_KEY=your_ksyun_access_key
KSYUN_SECRET_KEY=your_ksyun_secret_key
# KSYUN_REGION=your-region-here   #default: cn-beijing-6
KSC_AIPRO_API_KEY=your_ksyun_ai_pro_api_key #use for ksyun mcp market
