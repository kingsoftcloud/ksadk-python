{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezone.ksyun.com/schemas/agentengine/memory_backend_manifest/v1",
  "title": "MemoryBackendManifest",
  "description": "Memory backend manifest for OpenClaw runtime configuration.",
  "type": "object",
  "required": [
    "schema_version",
    "backend_type"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Schema version identifier. Must be 'v1'."
    },
    "backend_type": {
      "type": "string",
      "enum": [
        "openclaw_default",
        "mem0",
        "lancedb"
      ],
      "description": "Memory backend type. Supports 'openclaw_default', 'mem0', and 'lancedb'."
    },
    "config": {
      "type": "object",
      "description": "Backend-specific configuration.",
      "additionalProperties": true,
      "properties": {
        "mem0_instance_id": {
          "type": "string",
          "format": "uuid",
          "description": "Mem0 instance UUID (required when backend_type is 'mem0')."
        },
        "mem0_instance_name": {
          "type": "string",
          "description": "Mem0 instance display name."
        },
        "mem0_region": {
          "type": "string",
          "description": "Mem0 instance region."
        },
        "embedding_model": {
          "type": "string",
          "description": "Embedding model name for LanceDB (required when backend_type is 'lancedb')."
        },
        "embedding_dimensions": {
          "type": "integer",
          "description": "Embedding vector dimensions (e.g., 768)."
        },
        "embedding_provider": {
          "type": "string",
          "description": "Embedding provider (e.g., 'ollama'). Defaults to 'ollama'."
        },
        "embedding_base_url": {
          "type": "string",
          "description": "Embedding API base URL (e.g., 'http://127.0.0.1:11434/v1')."
        },
        "database_uri": {
          "type": "string",
          "description": "LanceDB storage URI (required when backend_type is 'lancedb'). e.g., 's3://my-bucket/openclaw/lancedb'."
        },
        "database_type": {
          "type": "string",
          "description": "Database type identifier. Defaults to 'lancedb'."
        },
        "storage_endpoint": {
          "type": "string",
          "description": "S3-compatible storage endpoint (e.g., 'http://minio:9000')."
        },
        "storage_region": {
          "type": "string",
          "description": "Storage region. Defaults to 'us-east-1'."
        },
        "storage_allow_http": {
          "type": "string",
          "description": "Allow HTTP (non-TLS) storage connections. Defaults to 'true'."
        }
      }
    },
    "secrets_env": {
      "type": "object",
      "description": "Environment variable names for secrets. Values are env var names, not actual secrets.",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "api_key": {
          "type": "string",
          "description": "Environment variable name for API key (e.g., 'MEM0_API_KEY')."
        },
        "memory_id": {
          "type": "string",
          "description": "Environment variable name for memory ID (e.g., 'MEM0_MEMORY_ID')."
        },
        "storage_access_key_id": {
          "type": "string",
          "description": "Environment variable name for S3 access key ID (e.g., 'LANCEDB_ACCESS_KEY_ID')."
        },
        "storage_secret_access_key": {
          "type": "string",
          "description": "Environment variable name for S3 secret access key (e.g., 'LANCEDB_SECRET_ACCESS_KEY')."
        },
        "embedding_api_key": {
          "type": "string",
          "description": "Environment variable name for embedding API key (e.g., 'LANCEDB_EMBEDDING_API_KEY'). Required when using a remote embedding provider that needs authentication."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend_type": { "const": "mem0" }
        }
      },
      "then": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["mem0_instance_id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backend_type": { "const": "lancedb" }
        }
      },
      "then": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["embedding_model", "database_uri"]
          }
        }
      }
    }
  ]
}
