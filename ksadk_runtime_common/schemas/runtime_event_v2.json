{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kingsoftcloud.github.io/ksadk-python/schemas/runtime_event_v2.json",
  "title": "RuntimeEvent schema v2",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "seq", "timestamp", "run_id", "scope_id", "source"],
  "properties": {
    "schema_version": {"const": 2},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "number"},
    "run_id": {"type": "string", "minLength": 1},
    "run_seq": {"type": ["integer", "null"], "minimum": 0},
    "scope_id": {"type": "string", "minLength": 1},
    "parent_scope_id": {"type": ["string", "null"], "minLength": 1},
    "source": {"$ref": "#/$defs/sourceRef"}
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "properties": {"event_type": {"const": "run.started"}, "status": {"const": "running"}},
      "required": ["status"]
    },
    {
      "properties": {
        "event_type": {"const": "run.progress"}, "status": {"const": "running"},
        "progress": {"type": ["number", "null"]}, "message": {"type": ["string", "null"]}
      },
      "required": ["status"]
    },
    {
      "properties": {
        "event_type": {"const": "run.interrupted"}, "status": {"const": "interrupted"},
        "reason": {"type": ["string", "null"]},
        "interaction_id": {"type": ["string", "null"], "minLength": 1},
        "continuation_id": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["status"]
    },
    {
      "properties": {
        "event_type": {"const": "run.completed"}, "status": {"const": "completed"},
        "output_refs": {"type": "array", "items": {"$ref": "#/$defs/outputRef"}}
      },
      "required": ["status", "output_refs"]
    },
    {
      "properties": {
        "event_type": {"const": "run.failed"}, "status": {"const": "failed"},
        "error": {"$ref": "#/$defs/errorInfo"}
      },
      "required": ["status", "error"]
    },
    {
      "properties": {
        "event_type": {"const": "run.canceled"}, "status": {"const": "canceled"},
        "reason": {"type": ["string", "null"]}
      },
      "required": ["status"]
    },
    {
      "properties": {
        "event_type": {"const": "item.started"}, "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"$ref": "#/$defs/itemKind"},
        "phase": {"anyOf": [{"$ref": "#/$defs/eventPhase"}, {"type": "null"}]},
        "initial": {"anyOf": [{"$ref": "#/$defs/contentSnapshot"}, {"type": "null"}]}
      },
      "required": ["item_id", "item_kind"]
    },
    {
      "properties": {
        "event_type": {"const": "item.updated"}, "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"$ref": "#/$defs/itemKind"}, "op": {"enum": ["append", "replace"]},
        "update": {"$ref": "#/$defs/contentValue"}
      },
      "required": ["item_id", "item_kind", "op", "update"]
    },
    {
      "properties": {
        "event_type": {"const": "item.snapshot_replaced"},
        "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"$ref": "#/$defs/itemKind"},
        "snapshot": {"$ref": "#/$defs/contentSnapshot"}
      },
      "required": ["item_id", "item_kind", "snapshot"]
    },
    {
      "properties": {
        "event_type": {"const": "item.completed"}, "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"$ref": "#/$defs/itemKind"}, "snapshot": {"$ref": "#/$defs/contentSnapshot"}
      },
      "required": ["item_id", "item_kind", "snapshot"]
    },
    {
      "properties": {
        "event_type": {"const": "item.failed"}, "item_id": {"type": "string", "minLength": 1},
        "item_kind": {"$ref": "#/$defs/itemKind"}, "error": {"$ref": "#/$defs/errorInfo"}
      },
      "required": ["item_id", "item_kind", "error"]
    },
    {
      "properties": {
        "event_type": {"const": "interaction.requested"},
        "interaction_id": {"type": "string", "minLength": 1},
        "interaction_kind": {"$ref": "#/$defs/interactionKind"},
        "request": {"$ref": "#/$defs/interactionRequest"}
      },
      "required": ["interaction_id", "interaction_kind", "request"],
      "oneOf": [
        {
          "properties": {
            "interaction_kind": {"const": "approval"},
            "request": {"properties": {"request_type": {"const": "approval"}}}
          }
        },
        {
          "properties": {
            "interaction_kind": {"const": "structured_input"},
            "request": {"properties": {"request_type": {"const": "structured_input"}}}
          }
        }
      ]
    },
    {
      "properties": {
        "event_type": {"const": "interaction.resolved"},
        "interaction_id": {"type": "string", "minLength": 1},
        "interaction_kind": {"$ref": "#/$defs/interactionKind"},
        "response": {"$ref": "#/$defs/interactionResponse"}
      },
      "required": ["interaction_id", "interaction_kind", "response"],
      "oneOf": [
        {
          "properties": {
            "interaction_kind": {"const": "approval"},
            "response": {"properties": {"response_type": {"const": "approval"}}}
          }
        },
        {
          "properties": {
            "interaction_kind": {"const": "structured_input"},
            "response": {"properties": {"response_type": {"const": "structured_input"}}}
          }
        }
      ]
    },
    {
      "properties": {
        "event_type": {"const": "continuation.created"},
        "continuation_id": {"type": "string", "minLength": 1},
        "continuation_kind": {"$ref": "#/$defs/continuationKind"},
        "resumable": {"type": "boolean"}, "ref": {"type": "object"}
      },
      "required": ["continuation_id", "continuation_kind", "resumable", "ref"]
    },
    {
      "properties": {
        "event_type": {"const": "continuation.resumed"},
        "continuation_id": {"type": "string", "minLength": 1},
        "continuation_kind": {"$ref": "#/$defs/continuationKind"},
        "resume_attempt_id": {"type": "string", "minLength": 1}
      },
      "required": ["continuation_id", "continuation_kind", "resume_attempt_id"]
    },
    {
      "properties": {
        "event_type": {"const": "context.compaction.started"},
        "trigger": {"type": "string", "minLength": 1}
      },
      "required": ["trigger"]
    },
    {
      "properties": {
        "event_type": {"const": "context.compaction.completed"},
        "trigger": {"type": "string", "minLength": 1},
        "compacted_until_seq": {"type": "integer", "minimum": 0}
      },
      "required": ["trigger", "compacted_until_seq"]
    },
    {
      "properties": {
        "event_type": {"const": "usage.reported"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0}
      },
      "required": ["input_tokens", "output_tokens", "total_tokens"]
    }
  ],
  "$defs": {
    "itemKind": {
      "enum": ["message", "reasoning", "tool_call", "tool_result", "artifact", "status", "data"]
    },
    "eventPhase": {"enum": ["commentary", "final_answer"]},
    "interactionKind": {"enum": ["approval", "structured_input"]},
    "continuationKind": {
      "enum": ["graph_checkpoint", "invocation_resume", "thread_resume", "task_resume"]
    },
    "sourceRef": {
      "type": "object",
      "required": ["framework"],
      "properties": {
        "framework": {"enum": ["adk", "langgraph", "codex", "a2a", "ksadk"]},
        "protocol": {"enum": ["a2ui", null]},
        "native_event_id": {"type": ["string", "null"]},
        "native_cursor": {"type": ["string", "null"]},
        "native_run_id": {"type": ["string", "null"]},
        "native_item_id": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "outputRef": {
      "type": "object",
      "required": ["scope_id", "item_id"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "part_id": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "errorInfo": {
      "type": "object",
      "required": ["code", "source", "scope_id"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "item_id": {"type": ["string", "null"]},
        "source_ref": {"anyOf": [{"$ref": "#/$defs/sourceRef"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "contentSnapshot": {
      "type": "object",
      "required": ["parts"],
      "properties": {"parts": {"type": "array", "items": {"$ref": "#/$defs/contentValue"}}},
      "additionalProperties": false
    },
    "contentValue": {
      "oneOf": [
        {"$ref": "#/$defs/textContent"}, {"$ref": "#/$defs/jsonContent"},
        {"$ref": "#/$defs/toolCallContent"}, {"$ref": "#/$defs/toolResultContent"},
        {"$ref": "#/$defs/artifactContent"}, {"$ref": "#/$defs/dataContent"}
      ]
    },
    "textContent": {"type": "object", "required": ["content_type", "part_id", "text"], "properties": {"content_type": {"const": "text"}, "part_id": {"type": "string", "minLength": 1}, "text": {"type": "string"}}, "additionalProperties": false},
    "jsonContent": {"type": "object", "required": ["content_type", "part_id", "value"], "properties": {"content_type": {"const": "json"}, "part_id": {"type": "string", "minLength": 1}, "value": {}}, "additionalProperties": false},
    "toolCallContent": {"type": "object", "required": ["content_type", "part_id", "call_id", "name", "arguments"], "properties": {"content_type": {"const": "tool_call"}, "part_id": {"type": "string", "minLength": 1}, "call_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "arguments": {}}, "additionalProperties": false},
    "toolResultContent": {"type": "object", "required": ["content_type", "part_id", "call_id", "result"], "properties": {"content_type": {"const": "tool_result"}, "part_id": {"type": "string", "minLength": 1}, "call_id": {"type": "string", "minLength": 1}, "result": {}, "is_error": {"type": "boolean"}}, "additionalProperties": false},
    "artifactContent": {"type": "object", "required": ["content_type", "part_id", "artifact_id", "name"], "properties": {"content_type": {"const": "artifact"}, "part_id": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "mime_type": {"type": ["string", "null"]}, "uri": {"type": ["string", "null"]}, "data": {}}, "additionalProperties": false},
    "dataContent": {"type": "object", "required": ["content_type", "part_id", "data"], "properties": {"content_type": {"const": "data"}, "part_id": {"type": "string", "minLength": 1}, "data": {}}, "additionalProperties": false},
    "interactionRequest": {
      "oneOf": [
        {"type": "object", "required": ["request_type", "kind"], "properties": {"request_type": {"const": "approval"}, "call_id": {"type": ["string", "null"]}, "kind": {"type": "string", "minLength": 1}, "detail": {}}, "additionalProperties": false},
        {"type": "object", "required": ["request_type", "schema"], "properties": {"request_type": {"const": "structured_input"}, "prompt": {"type": ["string", "null"]}, "schema": {"type": "object"}}, "additionalProperties": false}
      ]
    },
    "interactionResponse": {
      "oneOf": [
        {"type": "object", "required": ["response_type", "decision"], "properties": {"response_type": {"const": "approval"}, "decision": {"enum": ["approved", "rejected", "canceled"]}, "data": {}}, "additionalProperties": false},
        {"type": "object", "required": ["response_type", "data"], "properties": {"response_type": {"const": "structured_input"}, "data": {}}, "additionalProperties": false}
      ]
    }
  }
}
