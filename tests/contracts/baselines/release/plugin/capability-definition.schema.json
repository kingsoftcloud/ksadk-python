{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksadk.local/contracts/plugin/v1/capability-definition.schema.json",
  "title": "CapabilityDefinition/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "capability.ksadk.io/v1"},
    "kind": {"const": "CapabilityDefinition"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}
      },
      "required": ["id", "version"]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*/v[1-9][0-9]*$"},
        "slot": {"type": "string", "minLength": 3},
        "multiplicity": {"enum": ["unique", "multiple"]},
        "ownerRequired": {"type": "boolean"},
        "configSchema": {"type": ["string", "null"]}
      },
      "required": ["definition", "slot", "multiplicity"]
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}
